{
  "name": "taskdrop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.13 <11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/production/migrations dist/production/migrations",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"web/**/*.{ts,css,html}\" \"test/**/*.ts\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/**/*.{ts,css,html}\" \"test/**/*.ts\" \"*.{json,ts,mjs}\"",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "prototype:p1": "pnpm build && node dist/prototypes/p1-codex-mcp-smoke/server.js",
    "prototype:p2": "pnpm build && node dist/prototypes/p2-minimum-handoff/server.js",
    "prototype:p3": "pnpm build && node dist/prototypes/p3-chatgpt-hosted-compatibility/launcher.js",
    "prototype:p5": "pnpm build && node dist/prototypes/p5-real-user-handoff/server.js",
    "prototype:p6": "pnpm build && node dist/prototypes/p6-dual-era-contract/runner.js",
    "prototype:setup-cli": "pnpm build && node dist/prototypes/p7-space-key-cli/cli.js",
    "setup:cli": "pnpm build && node dist/production/setup-cli.js",
    "admin:cli": "pnpm build && node dist/production/admin-cli.js",
    "migrate": "pnpm build && node dist/production/migrate.js",
    "verify": "pnpm check && pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "pg": "8.16.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.0",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
