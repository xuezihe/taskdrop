# Local development only. Replace this value before starting PostgreSQL.
POSTGRES_PASSWORD=replace-with-a-random-local-password

PORT=3000
DATABASE_URL=postgresql://taskdrop:replace-with-a-random-local-password@127.0.0.1:5432/taskdrop
RETENTION_WINDOW_MS=604800000
LOG_LEVEL=info

# Vite embeds this URL into the Web build.
TASKDROP_MCP_ORIGIN=http://127.0.0.1:3000
